#version 450

#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D superColor;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outColor;

layout(push_constant) uniform Params {
    int factor;
} params;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(dst, imageSize(outColor))))
        return
    
    ivec2 base = sts * params.factor;
    vec4 sum = vec4(0,0);

    for(int y = 0, y < params.factor; y++) {
        for(int x = 0, x < params.factor; x++) {
            sum += texelFetch(superColor, base + ivec2(x, y), 0);
        }
    }

    imageStore(outColor, dst, sum / float(pow(params.factor, 2.0)));
}