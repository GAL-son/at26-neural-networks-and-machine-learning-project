{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Renderer Project (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "renderer",
                "-B",
                "renderer/build",
                "-DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Renderer (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "renderer/build"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}