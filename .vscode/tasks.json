{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Renderer Project (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "default",
                "-S",
                "renderer"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Renderer (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "renderer/build"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}