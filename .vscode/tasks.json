{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Renderer Project (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "renderer",
                "-B",
                "renderer/build",
                "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "args": [
                    "-S",
                    "renderer",
                    "-B",
                    "renderer/build",
                    "-G",
                    "Visual Studio 17 2022",
                    "-A",
                    "x64",
                    "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                ]
            },
            "linux": {
                "args": [
                    "-S",
                    "renderer",
                    "-B",
                    "renderer/build",
                    "-G",
                    "Ninja",
                    "-DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Build Renderer (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "renderer/build",
                "--config",
                "Debug"
            ],
            "windows": {
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "linux": {
                "problemMatcher": [
                    "$gcc"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the renderer project across platforms"
        }
    ]
} 